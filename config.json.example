{
  "dashboard": {
    "listen_addr": "127.0.0.1:8787"
  },
  "store": {
    "driver": "sqlite",
    "dsn": "./data/harness.db"
  },
  "llm": {
    "max_retries": 2,
    "retry_base_ms": 250,
    "breaker_consecutive_failures": 5,
    "breaker_cooldown_s": 60,
    "ladder_allow_repair": true,
    "ladder_allow_reask": true,
    "daily_token_budget": 0,
    "budget_warn_fraction": 0.8
  },
  "source": {
    "block_private_hosts": false,
    "max_bytes": 1048576,
    "timeout_ms": 10000
  },
  "providers": {
    "deepseek": { "base_url": "https://api.deepseek.com", "api_key_env": "DEEPSEEK_API_KEY", "models": ["deepseek-v4-flash", "deepseek-v4-pro"] },
    "openai": { "base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY", "models": ["gpt-4o-mini", "gpt-4o"] },
    "ollama": { "base_url": "http://localhost:11434/v1", "api_key_env": "", "models": ["llama3.2", "qwen2.5"] }
  }
}
