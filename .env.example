# Harness API keys — copy this file to `.env` (gitignored) and fill in
# the keys for the providers you use. The provider config's `api_key_env`
# names which variable to read. OpenRouter is the "one key, many models"
# path if you add it to `config.json` providers:
#   "openrouter": { "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY" }

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
